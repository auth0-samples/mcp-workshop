{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@xmcp/*": ["./.xmcp/*"]
    }
  },
  "include": ["src/**/*", "xmcp.config.ts", "xmcp-env.d.ts", ".xmcp/**/*"]
}
